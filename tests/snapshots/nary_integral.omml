  <m:nary>
    <m:naryPr>
      <m:chr m:val="∫"/>
      <m:limLoc m:val="subSup"/>
      <m:grow m:val="1"/>
      <m:subHide m:val="off"/>
      <m:supHide m:val="off"/>
    </m:naryPr>
    <m:sub>
      <m:r>
        <m:t>0</m:t>
      </m:r>
    </m:sub>
    <m:sup>
      <m:r>
        <m:t>1</m:t>
      </m:r>
    </m:sup>
    <m:e/>
  </m:nary>
  <m:r>
