<m:oMath xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:mml="http://www.w3.org/1998/Math/MathML">
  <m:d>
    <m:dPr>
      <m:begChr m:val="{"/>
      <m:sepChr m:val=","/>
      <m:endChr m:val=""/>
    </m:dPr>
    <m:e>
      <m:eqArr>
        <m:e>
          <m:r>
            <m:t>2x-y=0</m:t>
          </m:r>
        </m:e>
        <m:e>
          <m:r>
            <m:t>x+2y=5</m:t>
          </m:r>
        </m:e>
      </m:eqArr>
    </m:e>
  </m:d>
</m:oMath>
