# ===========================================================================
# MathSet 题库系统 — 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ===========================================================================

# ── 数据库 ──────────────────────────────────────────────────────────────────
# PostgreSQL 连接字符串（必填）
DATABASE_URL=postgres://your_user:your_password@localhost:5432/mathset

# 集成测试专用库（必填；cargo test 仅连接此库，不会回退到 DATABASE_URL）
DATABASE_URL_TEST=postgres://your_user:your_password@localhost:5432/mathset_test

# 数据库最大连接数（默认 50）
DATABASE_MAX_CONNECTIONS=50

# ── 认证 ────────────────────────────────────────────────────────────────────
# JWT 签名密钥（生产环境必须修改，至少 32 字符）
JWT_SECRET=your_jwt_secret_key_here_minimum_32_chars
# JWT Token 有效期（小时，默认 24）
JWT_EXPIRY_HOURS=24

# ── 服务 ────────────────────────────────────────────────────────────────────
# 服务监听地址（默认 0.0.0.0）
HOST=0.0.0.0
# 服务监听端口（默认 3000）
PORT=3000

# 用户上传文件根目录（头像等，默认 ./uploads）
UPLOAD_DIR=./uploads

# ── AI 配置 ─────────────────────────────────────────────────────────────────
# 默认 AI 提供商：deepseek | qwen | glm | gemini | openai | custom
AI_DEFAULT_PROVIDER=deepseek

# 用户个人 API Key 的 AES-256-GCM 加密主密钥（base64 编码 32 字节，可选）
AI_KEY_ENCRYPTION_KEY=your_32_byte_base64_encryption_key_here

# 默认文本生成模型
AI_DEFAULT_MODEL_TEXT=deepseek-chat
# 默认视觉模型
AI_DEFAULT_MODEL_VISION=qwen-vl-plus
# 打标专用模型（可选，留空回退 AI_DEFAULT_MODEL_TEXT）
# 打标是「抽关键词 + 从候选菜单选 ID」的结构化分类任务，用推理模型会把单题拖到
# 分钟级；解析用强模型、打标用快模型是最划算的搭配。
AI_DEFAULT_MODEL_TAGGING=deepseek-chat

# 打标 worker 并发数（默认 4）。拾取 SQL 用 FOR UPDATE SKIP LOCKED，多实例安全。
# 上游频繁 429 时下调。
TAGGING_WORKER_CONCURRENCY=4

# Stage2 切块并发数（默认 4；智谱/Gemini/`:free` 免费档自动降为 1）
STAGE2_CONCURRENCY=4

# 打标收敛调用超时（秒，默认 180）。收敛只需从候选菜单挑 ID，输出很短；
# 换成非推理的打标模型后通常 10s 内完成，可下调到 60。
TAGGING_CONVERGE_TIMEOUT_SECS=180

# ── Deepseek ────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 通义千问（阿里云百炼） ────────────────────────────────────────────────────
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com

# ── 智谱 GLM（OpenAI 兼容，文本清洗 / 拆题） ────────────────────────────────
# Flash 档 RPM/并发较低；拆题会自动单路，遇 429（code 1302）会退避重试
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── Google Gemini（OpenAI 兼容层，按免费档 RPM/TPM/RPD 限流） ──────────────
# https://ai.google.dev/gemini-api/docs/rate-limits
# 默认按 AI Studio Free（2026-08）：Flash 5 RPM / 250k TPM / 20 RPD；Flash-Lite 10/250k/20
# 以控制台为准时可覆盖：
# GEMINI_FREE_RPM=5
# GEMINI_FREE_TPM=250000
# GEMINI_FREE_RPD=20
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ── 自定义 / OpenRouter（用户在设置页填写，无需在此配置 Key） ──────────────
# 设置页选「自定义 / OpenRouter」后填写：
#   Base URL 默认 https://openrouter.ai/api/v1
#   模型 ID 须写完整名，如 stealth/ox-alpha（Ox Alpha）或 qwen/qwen3-8b:free
# OpenRouter 可选请求头（用于排行榜；部分免费模型会校验 Referer）
# OPENROUTER_HTTP_REFERER=https://github.com/supikachu/mathsets
# OPENROUTER_APP_TITLE=MathSet

# ── OCR 引擎平台默认配置（v1.1 新增，见需求分析 §2.2.3） ──────────────────────
# 默认 OCR 引擎：auto（智能选择）| doc2x | mineru_local | mineru_api | qwen_vl
OCR_DEFAULT_PROVIDER=auto
# Doc2X 平台默认 Key（用户未配个人 Key 时兜底；建议留空让用户自带）
DOC2X_API_KEY=
# v2 官方端点（裸域名，路径需含 /api/v2 前缀，由代码内部拼接）
DOC2X_BASE_URL=https://v2.doc2x.noedgeai.com
# MinerU 平台默认私有部署地址（可选，私有化方案时填写）
MINERU_DEFAULT_ENDPOINT=
# MinerU Cloud 平台默认 Key（可选）
MINERU_API_KEY=

# ── 智能打标观测 ────────────────────────────────────────────────────────────
# 设为 1 时，解析预览对比旧 Top1（含 fuzzy）与引擎确定性匹配，不额外调用 LLM
TAGGING_SHADOW_COMPARE=0
# 打标向量召回（默认开；设为 0 关闭。无 pgvector / 无 QWEN_API_KEY 时自动退回字面召回）
TAGGING_VECTOR_RECALL=1
# 仅集成测试使用：设为 1 时才在 cargo test 中启用向量召回（默认关，避免误打 DashScope）
# TAGGING_VECTOR_RECALL_TEST=0

