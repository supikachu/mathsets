# ==========================================
# 1. 操作系统与临时文件
# ==========================================
*.DS_Store
Thumbs.db
*.~
tmp/
/tmp/
logs/
*.log
__pycache__/
*.pyc

# ==========================================
# 2. 编辑器与 AI 工具配置 (IDE & Tooling)
# ==========================================
.vscode/
.idea/
.trae/
.workbuddy/
.codegraph/
.reasonix/

# ==========================================
# 3. 敏感环境变量 (Environment Variables)
# ==========================================
.env
.env.local
.env.*
#.env.example 必须被版本控制追踪，因此强制例外：
!.env.example

# ==========================================
# 4. 用户上传/测试数据 (Uploads & Assets)
# ==========================================
/uploads/
/.uploads/
questions/
.pg_reload.sql

# 全自动解析压测：账号、试卷 PDF、运行结果不入库
bench/credentials.txt
bench/inbox/*
!bench/inbox/.gitkeep
!bench/inbox/PUT_PDFS_HERE.txt
bench/out/
bench/eval/*
!bench/eval/.gitkeep
!bench/eval/README.txt

# ==========================================
# 5. Rust 后端编译输出 (Cargo / Rust)
# ==========================================
/target/
**/*.rs.bk

# 如果不需要 SQLx 离线准备数据，可以取消下面这行的注释：
# .sqlx/

# ts-rs 绑定默认输出目录（本项目经 export_to 直写 frontend/src/api/types/）
/bindings/

# ==========================================
# 6. 前端构建与依赖 (Frontend)
# ==========================================
/node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/*.tsbuildinfo

# 前端本地环境变量
frontend/.env.local
frontend/.env.*.local   
/target-itest/
